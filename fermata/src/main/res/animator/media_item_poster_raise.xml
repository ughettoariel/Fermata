<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV style lift: grow slightly when focused or pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:duration="150" android:propertyName="scaleX" android:valueTo="1.06" />
            <objectAnimator android:duration="150" android:propertyName="scaleY" android:valueTo="1.06" />
            <objectAnimator android:duration="150" android:propertyName="translationZ" android:valueTo="8dp" />
        </set>
    </item>
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:duration="100" android:propertyName="scaleX" android:valueTo="1.04" />
            <objectAnimator android:duration="100" android:propertyName="scaleY" android:valueTo="1.04" />
            <objectAnimator android:duration="100" android:propertyName="translationZ" android:valueTo="6dp" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="150" android:propertyName="scaleX" android:valueTo="1.0" />
            <objectAnimator android:duration="150" android:propertyName="scaleY" android:valueTo="1.0" />
            <objectAnimator android:duration="150" android:propertyName="translationZ" android:valueTo="0dp" />
        </set>
    </item>
</selector>
